{
  "name": "wika-plugins",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "npm run build -w @wika/core && npm run build -w @wika/react && npm run build -w @wika/demo && npm run build -w @wika/owners",
    "dev": "npm run build -w @wika/core && npm run build -w @wika/react && npm run dev -w @wika/demo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run packages/core/tests/live.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:compatibility": "node ./compatibility/run.mjs",
    "dev:owners": "npm run build -w @wika/core && npm run build -w @wika/react && npm run dev -w @wika/owners",
    "test:portfolio-indexer": "npm run build -w @wika/core && node compatibility/portfolio-indexer.mjs",
    "test:portfolio-browser": "node compatibility/portfolio-browser.mjs",
    "test:portfolio-live": "node compatibility/portfolio-live.mjs",
    "test:referrals-live": "npm run build -w @wika/core && node compatibility/referrals-live.mjs",
    "test:economics-live": "npm run build -w @wika/core && node compatibility/economics-live.mjs",
    "test:economics-browser": "node compatibility/economics-browser.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "happy-dom": "21.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "@polkadot/util-crypto": "14.0.3"
  }
}
