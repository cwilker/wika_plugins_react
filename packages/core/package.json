{
  "name": "@wika/core",
  "version": "0.1.0",
  "description": "Framework-independent Wika chain client and wallet adapters",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap"
  },
  "dependencies": {
    "@polkadot/api": "16.5.6",
    "@polkadot/types": "16.5.6",
    "@polkadot/util-crypto": "14.0.3",
    "@polkadot/util": "14.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
